SOURCE_TABLE = f"{CATALOG}.{SCHEMA}.upstream_customer_scd2_iceberg_demo"
TARGET_TABLE = f"{CATALOG}.{SCHEMA}.target_customer_scd2_iceberg_demo"
BUSINESS_KEY = "customer_id"
TRACKED_COLS = ["customer_name", "city"]
DATA_COLS = ["customer_id", "customer_name", "city", "valid_from", "valid_to", "is_current"]



FULL_REFRESH_QUERY = """
SELECT customer_id, customer_name, city, valid_from, valid_to, is_current
FROM source_snapshot

"""


import uuid
from datetime import datetime, timezone


def latest_version(table):
    """Latest commit version of a table (works for Iceberg v3 and Delta)."""
    return spark.sql(f"DESCRIBE HISTORY {table} LIMIT 1").first()["version"]

def full_refresh():
    # 1. Rollback point: target version before we touch it
    target_before = latest_version(TARGET_TABLE)
    # 2. Pin the source version we copy from
    n = latest_version(SOURCE_TABLE)
    # 3. Expose the pinned source as `source_snapshot` and run your query on it
    df =spark.sql(f"SELECT * FROM {SOURCE_TABLE} VERSION AS OF {n}")
    df.createOrReplaceTempView("source_snapshot")
    result = spark.sql(FULL_REFRESH_QUERY)
    result.select(*DATA_COLS).write.mode("overwrite").insertInto(TARGET_TABLE)
    target_after = latest_version(TARGET_TABLE)
    # 4. New checkpoint path: UTC timestamp + source version
    ts = datetime.now(timezone.utc).strftime("%Y%m%d_%H%M%S")
    checkpoint_path = f"{CHECKPOINT_BASE}/{FLOW_NAME}/fr_{ts}_v{n}"
    spark.sql(f"""
      MERGE INTO {CONTROL_TABLE} AS c
      USING (
        SELECT :flow AS merge_key
        UNION ALL
        SELECT NULL AS merge_key
      ) AS s
      ON c.flow_name = s.merge_key AND c.status = 'active'
      WHEN MATCHED THEN UPDATE SET
        c.status = 'retired',
        c.retired_at = current_timestamp()
      WHEN NOT MATCHED AND s.merge_key IS NULL THEN INSERT
        (flow_name, run_id, checkpoint_path, source_table, target_table, source_start_version,
         target_version_before, target_version_after, status, created_at, created_by, retired_at)
        VALUES (:flow, :run_id, :ckpt, :src, :tgt, :n, :tb, :ta,
                'active', current_timestamp(), current_user(), NULL)
    """, args={"flow": FLOW_NAME, "run_id": str(uuid.uuid4()), "ckpt": checkpoint_path,
               "src": SOURCE_TABLE, "tgt": TARGET_TABLE, "n": n,
               "tb": target_before, "ta": target_after})
    print(f"FULL REFRESH done: source v{n} -> target v{target_before}->v{target_after}")
    print(f"Active checkpoint: {checkpoint_path}")
    return checkpoint_path, n




