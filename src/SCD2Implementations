CHECKPOINT_VOLUME = f"{CATALOG}.{SCHEMA}.stream_checkpoints"
CHECKPOINT_PATH = f"/Volumes/{CATALOG}/{SCHEMA}/stream_checkpoints/customer_scd2_iceberg_demo"

CONTROL_TABLE = f"{CATALOG}.{SCHEMA}.stream_load_control"
FLOW_NAME = "customer_scd2_iceberg_demo"   # identifies this source->target flow in the control table
CHECKPOINT_BASE = f"/Volumes/{CATALOG}/{SCHEMA}/stream_checkpoints/flows"

